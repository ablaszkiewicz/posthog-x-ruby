# Gemfile
source 'https://rubygems.org'

# Specify the Ruby version
ruby '3.3.0' # Adjust this to your Ruby version if needed

# Core gems
gem 'posthog-ruby', '~> 3.2'  # PostHog analytics and feature flags

# Development dependencies
group :development do
  gem 'rubocop', '~> 1.0' # Ruby linter and formatter
  gem 'pry', '~> 0.14'    # Interactive debugger
end

# Test dependencies
group :test do
  gem 'rspec', '~> 3.0'   # Testing framework
  gem 'minitest', '~> 5.0' # Alternative testing framework
end

